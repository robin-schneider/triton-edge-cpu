ARG BUILD_IMAGE=tritonserver_buildbase:latest
ARG CORE_IMAGE=tritonserver:latest
FROM ${BUILD_IMAGE} AS python-build
ARG PYTHON_BACKEND_COMMIT=945764622b31dc48e881e6fb109971503a29c637
ARG TRITON_GIT_REF=r26.09
ARG BUILD_JOBS=8
ARG SOURCE_DATE_EPOCH
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
WORKDIR /python-build
RUN cp -a /opt/locked/checkouts/python_backend source
RUN cmake -S source -B build -DCMAKE_BUILD_TYPE=Release -DTRITON_ENABLE_GPU=OFF \
    -DTRITON_ENABLE_METRICS=ON -DTRITON_ENABLE_STATS=ON \
    -DTRITON_BACKEND_REPO_TAG=${TRITON_GIT_REF} -DTRITON_COMMON_REPO_TAG=${TRITON_GIT_REF} \
    -DTRITON_CORE_REPO_TAG=${TRITON_GIT_REF} -DPython3_EXECUTABLE=/usr/bin/python3 \
    -DTRITON_BOOST_URL=file:///opt/locked/boost.tar.gz \
    -DCMAKE_INSTALL_PREFIX=/python-install \
    && cmake --build build --parallel ${BUILD_JOBS} \
    && cmake --install build

# Combined artifact source, never deployed. Only selected runtime files are
# copied by Dockerfile.runtime; no Python build tools cross that boundary.
FROM ${CORE_IMAGE} AS artifacts
COPY --from=python-build /python-install/backends/python /opt/tritonserver/backends/python
