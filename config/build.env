# Pinned release inputs. Update these together after reviewing NVIDIA's release notes.
TRITON_GIT_REF=r26.09
TRITON_SOURCE_COMMIT=818762530159ad144f7eee99bd264adcd9389e44
TRITON_VERSION=2.73.0
TRITON_CONTAINER_VERSION=26.09
TRITON_UPSTREAM_CONTAINER_VERSION=26.09

# Reproducible local image names.
TRITON_IMAGE=local/tritonserver-cpu:26.09
TOOLING_IMAGE=local/triton-cpu-build-tools:26.09
GATEWAY_IMAGE=local/triton-cpu-gateway:26.09
ARTIFACT_IMAGE=local/triton-cpu-artifacts:26.09
PYTHON_BACKEND_COMMIT=945764622b31dc48e881e6fb109971503a29c637

# PyTorch's NVIDIA-supported CPU-only backend build still copies selected
# CUDA stubs/runtime dependencies from this image. It does not enable GPU use.
TRITON_GPU_BASE_IMAGE=nvcr.io/nvidia/tritonserver:26.09-py3-min

# Tune for the build host. Triton's C++ compilation can use roughly 2 GiB/job.
BUILD_JOBS=8

# Supply 1 to collect an OCI-compatible docker archive in make artifacts.
EXPORT_IMAGE=0

